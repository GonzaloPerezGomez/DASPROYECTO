<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".SeleccionarUbicacionActivity">

    <!-- Fragmento del mapa proporcionado por Google -->
    <fragment
        android:id="@+id/fragmentoMapa"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Barra semi-transparente arriba para volver -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarMapa"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_alignParentTop="true"
        android:background="#A6000000"
        app:title="Selecciona en el mapa"
        app:titleTextColor="@android:color/white" />

    <!-- Panel inferior para mostrar información y confirmar -->
    <androidx.cardview.widget.CardView
        android:id="@+id/panelInferiorMapa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dirección seleccionada"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvDireccionMapa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Pulsa en el mapa para situar la tarea..."
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnConfirmarUbicacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="CONFIRMAR UBICACIÓN"
                android:enabled="false" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</RelativeLayout>
