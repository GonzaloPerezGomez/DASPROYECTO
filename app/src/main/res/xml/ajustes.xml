<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- ═══ Idioma ═══ -->
    <PreferenceCategory app:title="@string/config_seccion_idioma">

        <ListPreference
            app:key="idioma"
            app:title="@string/config_idioma_label"
            app:summary="@string/config_idioma_summary"
            app:entries="@array/idiomas_array"
            app:entryValues="@array/idiomas_values"
            app:defaultValue="es" />

    </PreferenceCategory>

    <!-- ═══ Opciones de visualización ═══ -->
    <PreferenceCategory app:title="@string/config_seccion_visualizacion">

        <CheckBoxPreference
            app:key="ocultar_completadas"
            app:title="@string/config_ocultar_completadas"
            app:summary="@string/config_ocultar_completadas_summary"
            app:defaultValue="false" />

        <ListPreference
            app:key="orden_defecto"
            app:title="@string/config_orden_defecto"
            app:summary="@string/config_orden_defecto_summary"
            app:entries="@array/orden_defecto_array"
            app:entryValues="@array/orden_defecto_values"
            app:defaultValue="fecha" />

    </PreferenceCategory>

    <!-- ═══ Notificaciones ═══ -->
    <PreferenceCategory app:title="@string/config_seccion_notificaciones">

        <androidx.preference.SwitchPreferenceCompat
            app:key="notificaciones"
            app:title="@string/config_notificaciones"
            app:summary="@string/config_notificaciones_summary"
            app:defaultValue="false" />

    </PreferenceCategory>

    <!-- ═══ Datos ═══ -->
    <PreferenceCategory app:title="@string/config_seccion_datos">

        <androidx.preference.SwitchPreferenceCompat
            app:key="confirmar_eliminar"
            app:title="@string/config_confirmar_eliminar"
            app:summary="@string/config_confirmar_eliminar_summary"
            app:defaultValue="true" />

    </PreferenceCategory>

</PreferenceScreen>
