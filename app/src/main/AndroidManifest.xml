<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permiso para mostrar notificaciones (obligatorio en Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Permiso para re-programar la alarma tras reinicio del dispositivo -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Permiso para alarmas exactas (obligatorio en Android 12+) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Permiso para conexión a internet (obligatorio para BBDD remota) -->
    <uses-permission android:name="android.permission.INTERNET" />
    
    <!-- Permisos de localización requeridos para Google Maps y FusedLocationProvider -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Permisos para el servicio en primer plano de ubicación -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Permiso para la cámara -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Permisos para el proveedor de calendario -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <application
        android:name=".utils.Idioma"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.DASPROYECTO">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <activity
            android:name=".ui.activities.MainActivity"
            android:launchMode="singleTop"
            android:exported="false">
        </activity>
        
        <activity
            android:name=".ui.activities.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <activity
            android:name=".ui.activities.RegistroActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"/>
        <activity
            android:name=".ui.activities.AddTareaActivity"
            android:parentActivityName=".ui.activities.MainActivity" />
        <activity
            android:name=".ui.activities.EditTareaActivity"
            android:parentActivityName=".ui.activities.MainActivity" />
        <activity
            android:name=".ui.activities.ViewTareaActivity"
            android:exported="false"
            android:label="@string/label_ver_tarea"
            android:parentActivityName=".ui.activities.MainActivity" />
        <activity
            android:name=".ui.activities.SeleccionarUbicacionActivity"
            android:exported="false"
            android:label="Seleccionar Ubicación"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />
        <activity
            android:name=".ui.activities.AjustesActivity"
            android:label="@string/config_titulo"
            android:parentActivityName=".ui.activities.MainActivity" />

        <!--
            NotificacionReceiver: se ejecuta cuando salta la alarma de AlarmManager.
            No necesita intent-filter porque se invoca mediante PendingIntent
            (Android ya sabe qué clase ejecutar por el Intent explícito).
            exported="false" porque solo nuestra app lo usa.
        -->
        <receiver
            android:name=".receiver.NotificacionReceiver"
            android:exported="false" />

        <!--
            BootReceiver: se ejecuta automáticamente tras reiniciar el teléfono.
            El intent-filter BOOT_COMPLETED le dice a Android que lo ejecute al arrancar.
            exported="true" es obligatorio porque el evento viene del sistema (fuera de nuestra app).
        -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
            FileProvider: permite compartir archivos privados (ej: fotos temporales)
            con aplicaciones externas (ej: la app de la cámara).
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".services.background.ProximidadService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <!-- Servicio FCM: recibe mensajes de Firebase Cloud Messaging (Hito 9) -->
        <service
            android:name=".services.background.MiFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
            
        <provider
            android:name=".data.provider.TareasContentProvider"
            android:authorities="com.example.dasproyecto.provider"
            android:exported="true" />

        <!-- Widget de Próximas Tareas (Hito 8) -->
        <receiver
            android:name=".widget.TareasWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

    </application>


</manifest>