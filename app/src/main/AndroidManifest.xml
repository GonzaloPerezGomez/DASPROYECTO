<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permiso para mostrar notificaciones (obligatorio en Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Permiso para re-programar la alarma tras reinicio del dispositivo -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Permiso para conexión a internet (obligatorio para BBDD remota) -->
    <uses-permission android:name="android.permission.INTERNET" />
    
    <!-- Permisos de localización requeridos para Google Maps y FusedLocationProvider -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Permiso para la cámara -->
    <uses-permission android:name="android.permission.CAMERA" />

    <application
        android:name=".Idioma"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.DASPROYECTO">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:exported="false">
        </activity>
        
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <activity
            android:name=".RegistroActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"/>
        <activity
            android:name=".AddTareaActivity"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".EditTareaActivity"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ViewTareaActivity"
            android:exported="false"
            android:label="@string/label_ver_tarea"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".SeleccionarUbicacionActivity"
            android:exported="false"
            android:label="Seleccionar Ubicación"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />
        <activity
            android:name=".AjustesActivity"
            android:label="@string/config_titulo"
            android:parentActivityName=".MainActivity" />

        <!--
            NotificacionReceiver: se ejecuta cuando salta la alarma de AlarmManager.
            No necesita intent-filter porque se invoca mediante PendingIntent
            (Android ya sabe qué clase ejecutar por el Intent explícito).
            exported="false" porque solo nuestra app lo usa.
        -->
        <receiver
            android:name=".notification.NotificacionReceiver"
            android:exported="false" />

        <!--
            BootReceiver: se ejecuta automáticamente tras reiniciar el teléfono.
            El intent-filter BOOT_COMPLETED le dice a Android que lo ejecute al arrancar.
            exported="true" es obligatorio porque el evento viene del sistema (fuera de nuestra app).
        -->
        <receiver
            android:name=".notification.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
            FileProvider: permite compartir archivos privados (ej: fotos temporales)
            con aplicaciones externas (ej: la app de la cámara).
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>


</manifest>